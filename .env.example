# Generate private values with: python3 scripts/setup_env.py
POSTGRES_PASSWORD=
JWT_SECRET=
DEMO_PASSWORD=
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
MODE=demo
DATABASE_URL=sqlite:///./sprintgraph.db
FRONTEND_ORIGIN=http://localhost:3000
GITHUB_TOKEN=
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
LLM_PROVIDER=demo
# Enable only after explicitly authorizing real model inference.
LLM_INFERENCE_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
MAX_ATTEMPTS=3
STALLED_DAYS=7
PRIORITY_WEIGHTS={"Highest":50,"High":35,"Medium":20,"Low":10,"Lowest":0}
WORKFLOW_TIMEOUT_SECONDS=120

# Jira Cloud: enhanced uses token pagination; legacy is an explicit compatibility mode.
JIRA_ISSUE_API=enhanced
# Optional: select an active sprint when the board has parallel sprints.
# JIRA_SPRINT_ID=12
JIRA_STATUS_MAP={}
# Optional: custom field ID and label-to-severity map (0–10).
JIRA_SEVERITY_FIELD=
JIRA_SEVERITY_MAP={}

# Gemini alternative (keep inference disabled until explicitly approved):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_API_KEY=<private Gemini API key>
# LLM_INFERENCE_ENABLED=false
